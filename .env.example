# Copy to .env / set in your shell. Never commit real secrets.

# --- Auth (required when PRODUCTION_MODE=true) ---
# AUTH_SECRET=change-me-to-a-long-random-string
# AUTH_USERS=ashok:$2b$10$...   # seeded users (node scripts/hash-password.mjs "password")
# Seed DB users on server:
# npm run create-user -- username password --admin

# --- Server ---
# PORT=4173
# DATABASE_URL=postgresql://user:pass@host.postgres.database.azure.com:5432/traderscope?sslmode=require
# DATABASE_PATH=C:\Trade Analysis\ashok-trade-analysis\data\asx.sqlite   # local dev when DATABASE_URL unset

# --- Market data (EODHD only — Yahoo removed) ---
# EODHD_API_TOKEN=your_api_token
# DATA_PROVIDER=eodhd            # always eodhd (legacy yahoo/auto ignored)
# EODHD_ONLY=true                # always on when token set
# EODHD_MIN_GAP_MS=550           # min gap between EODHD API calls (avoid 429)
# EODHD_429_BACKOFF_MS=60000     # wait when EODHD returns 429
# EODHD_SNAPSHOT_CONCURRENCY=1   # snapshot parallel fetches (keep 1 on Render)
# EODHD_SNAPSHOT_DELAY_MS=250    # extra delay between snapshot ticker fetches
# ASX_FILINGS_POLL_MS=900000     # poll ASX Markit for Appendix 3Y (default 15m, $0)
# ASX_FILINGS_DISABLED=true      # turn off director-filings ingest

# --- Production / multi-user desk ---
# PRODUCTION_MODE=true           # disables browser universe crawl (recommended for 200 users)
# ADMIN_USERS=ops,admin          # users allowed to POST snapshot refresh / retry-failed
# ADMIN_API_KEY=long-random-key  # x-admin-key for Azure Logic App cron (see DEPLOY.md)
# LIVE_QUOTE_INTERVAL_MS=1800000        # default 30 min in production (15 min in dev)
# Each refresh costs ~1 EODHD API call per ticker polled (snapshot stocks only when partial).
# SERIES_RATE_LIMIT=2000         # /api/series per IP per minute (default 2000 in production)
# SNAPSHOT_RATE_LIMIT=60         # /api/snapshot GET per IP per minute
# SNAPSHOT_MIN_STOCK_RATIO=0.35  # min loaded/total to accept snapshot in production

# --- Maintenance ---
# MAINTENANCE_MODE=true            # show maintenance page; snapshot jobs still run in background
# MAINTENANCE_MESSAGE=Custom text  # optional message on the maintenance screen

# --- Alert email (pattern alerts → opted-in users) ---
# Official mailbox: alerts@traderscope.com (Microsoft 365 / your SMTP host).
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=alerts@traderscope.com
# SMTP_PASS=...
# SMTP_FROM=TradersScope Alerts <alerts@traderscope.com>   # default if unset
# PUBLIC_SITE_URL=https://traderscope.com

# --- Index membership (breadth universes) ---
# EODHD_INDEX_ASX200=AXJO.INDX       # S&P/ASX 200
# EODHD_INDEX_TOP500=AORD.INDX       # All Ordinaries (~500 largest on ASX)
# EODHD_INDEX_SMALL=AXSO.INDX        # S&P/ASX Small Ordinaries
# INDEX_MEMBERS_REFRESH_MS=86400000  # auto-refresh on server (default 24h, ~30 API calls)
# Prefer: npm run refresh:index-members
# Fallback IOZ proxy: npm run refresh:asx200
